    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "qrcode.react": "^4.2.0",
