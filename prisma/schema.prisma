// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum CategoryType {
    NORMAL
    IMAGE
    AGGREGATE
    RANKING
}

model Session {
    id            String        @id @default(cuid())
    name          String
    // The URL name of shows from before room codes, kept so their old links redirect to the
    // code. New shows have none.
    slug          String?       @unique
    // The show's room code, e.g. "K7QF": in its URLs and typed by voters on the homepage. The database
    // picks an unused one (generate_room_code(), see the room code migrations).
    code          String        @unique @default(dbgenerated("generate_room_code()"))
    // bcrypt hash. Required for new shows; shows from before that may have none, and are open.
    password      String?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    categories    Category[]
    loginAttempts LoginAttempt[]
}

// Manage password attempts for a show, so the limits hold across server instances. One row per
// client (a keyed hash of its IP address, never the address itself), and one for the whole show.
model LoginAttempt {
    sessionId     String
    session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    client        String
    failures      Int
    lastFailureAt DateTime

    @@id([sessionId, client])
}

model Category {
    id               String       @id @default(cuid())
    name             String
    description      String?
    revealed         Boolean      @default(false)
    isActive         Boolean      @default(false)
    votingClosed     Boolean      @default(false) // The host stopped voting before the reveal
    type             CategoryType @default(NORMAL)
    rankingTop       Int? // How many to rank (e.g., 3 = top 3) - only for RANKING type
    hideVoteCounts   Boolean      @default(false) // Hide vote numbers in presentation, only show rankings
    winnerOnly       Boolean      @default(false) // Only reveal the winner, hide runner-ups
    position         Int          @default(0) // Place in the show's running order, from 0
    sourceCategories Category[]   @relation("AggregateToSource")
    aggregateOf      Category[]   @relation("AggregateToSource")
    sessionId        String
    session          Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    nominations      Nomination[]
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt

    @@index([sessionId, position])
}

model Nomination {
    id          String   @id @default(cuid())
    name        String
    description String?
    categoryId  String
    category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    votes       Vote[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([categoryId])
}

model Vote {
    id           String     @id @default(cuid())
    deviceId     String
    nominationId String
    rank         Int? // Position for ranking votes (1 = 1st place, null for normal votes)
    nomination   Nomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
    createdAt    DateTime   @default(now())

    @@unique([deviceId, nominationId])
    @@index([nominationId])
}
