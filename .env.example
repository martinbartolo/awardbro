# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Neon Postgres. Easiest: `vercel env pull .env.local` (Development points at the Neon `dev` branch).
# Pooled connection, used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection, required: Prisma migrations (prisma.config.ts) and listening for
# live events (src/server/event-hub.ts), which the pooler cannot do
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Only for a plain Postgres server instead of Neon: "pg". The end-to-end tests set it themselves.
# DATABASE_DRIVER="pg"

# Signs manage-access cookies (min 32 chars). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Tests only (`pnpm test:integration` and `pnpm test:e2e`): a Postgres database whose name ends in
# _test. The integration tests delete all its data; the end-to-end tests run the app against it.
# Set it in the shell when running them; it isn't read from .env files. See "Integration tests" and
# "End-to-end tests" in docs/development.md.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/awardbro_test"
# The port the end-to-end tests start the app on (default 3200)
# E2E_PORT=3200
# Optional for the load test (scripts/load-test.ts): the Neon dev branch's direct connection, to
# count the connections a simulated show uses. Set it in the shell; never production's.
# LOAD_TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
